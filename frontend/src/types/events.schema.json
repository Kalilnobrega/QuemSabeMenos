{
  "$defs": {
    "Bonus": {
      "description": "Bônus da partida: gabaritar as fáceis, sequências de acertos (positivo) e sequências\nde erros (negativo). Uma sequência repetida na mesma partida vale a metade.",
      "properties": {
        "kind": {
          "enum": [
            "perfect_easy",
            "streak",
            "wrong_streak"
          ],
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "delta": {
          "type": "integer"
        },
        "repeat": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "count",
        "delta",
        "repeat"
      ],
      "title": "Bonus",
      "type": "object"
    },
    "CreateRoomRequest": {
      "properties": {
        "nickname": {
          "maxLength": 16,
          "minLength": 1,
          "type": "string"
        },
        "avatar": {
          "enum": [
            "burro",
            "cachorro",
            "coelho",
            "coruja",
            "galinha",
            "gato",
            "leao",
            "macaco",
            "ovelha",
            "panda",
            "pinguim",
            "porco",
            "raposa",
            "sapo",
            "urso",
            "vaca"
          ],
          "type": "string"
        }
      },
      "required": [
        "nickname",
        "avatar"
      ],
      "title": "CreateRoomRequest",
      "type": "object"
    },
    "ErrorAck": {
      "properties": {
        "ok": {
          "const": false,
          "default": false,
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "title": "ErrorAck",
      "type": "object"
    },
    "GameView": {
      "description": "Fases de cada rodada: reading (texto aparecendo, respostas bloqueadas) →\nanswering → results. Telas de preparação, em que a pergunta não é enviada: starting\n(antes da 1ª pergunta), level (quando a dificuldade muda) e intro (antes da final).\nDepois da última rodada: finished.",
      "properties": {
        "round": {
          "type": "integer"
        },
        "total_rounds": {
          "type": "integer"
        },
        "phase": {
          "enum": [
            "starting",
            "level",
            "intro",
            "reading",
            "answering",
            "results",
            "finished"
          ],
          "type": "string"
        },
        "phase_duration_ms": {
          "type": "integer"
        },
        "phase_ends_in_ms": {
          "type": "integer"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "impossible"
          ],
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionView"
            },
            {
              "type": "null"
            }
          ]
        },
        "answered": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "correct_option": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "fact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "items": {
            "$ref": "#/$defs/RoundResult"
          },
          "type": "array"
        }
      },
      "required": [
        "round",
        "total_rounds",
        "phase",
        "phase_duration_ms",
        "phase_ends_in_ms",
        "difficulty",
        "question",
        "answered",
        "correct_option",
        "fact",
        "results"
      ],
      "title": "GameView",
      "type": "object"
    },
    "JoinRoomRequest": {
      "properties": {
        "nickname": {
          "maxLength": 16,
          "minLength": 1,
          "type": "string"
        },
        "avatar": {
          "enum": [
            "burro",
            "cachorro",
            "coelho",
            "coruja",
            "galinha",
            "gato",
            "leao",
            "macaco",
            "ovelha",
            "panda",
            "pinguim",
            "porco",
            "raposa",
            "sapo",
            "urso",
            "vaca"
          ],
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "nickname",
        "avatar",
        "code"
      ],
      "title": "JoinRoomRequest",
      "type": "object"
    },
    "JoinedAck": {
      "description": "Resposta de create_room, join_room e rejoin_room quando dá certo.",
      "properties": {
        "ok": {
          "const": true,
          "default": true,
          "type": "boolean"
        },
        "player_id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "room": {
          "$ref": "#/$defs/RoomState"
        }
      },
      "required": [
        "ok",
        "player_id",
        "token",
        "room"
      ],
      "title": "JoinedAck",
      "type": "object"
    },
    "OkAck": {
      "properties": {
        "ok": {
          "const": true,
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "title": "OkAck",
      "type": "object"
    },
    "PlayerView": {
      "properties": {
        "id": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "avatar": {
          "enum": [
            "burro",
            "cachorro",
            "coelho",
            "coruja",
            "galinha",
            "gato",
            "leao",
            "macaco",
            "ovelha",
            "panda",
            "pinguim",
            "porco",
            "raposa",
            "sapo",
            "urso",
            "vaca"
          ],
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "score": {
          "type": "integer"
        },
        "answer_ms": {
          "type": "integer"
        },
        "streak": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "nickname",
        "avatar",
        "connected",
        "score",
        "answer_ms",
        "streak"
      ],
      "title": "PlayerView",
      "type": "object"
    },
    "Pong": {
      "properties": {
        "server_time": {
          "type": "number"
        }
      },
      "required": [
        "server_time"
      ],
      "title": "Pong",
      "type": "object"
    },
    "QuestionView": {
      "properties": {
        "text": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "theme": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "impossible"
          ],
          "type": "string"
        }
      },
      "required": [
        "text",
        "options",
        "theme",
        "difficulty"
      ],
      "title": "QuestionView",
      "type": "object"
    },
    "RejoinRoomRequest": {
      "properties": {
        "code": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "token"
      ],
      "title": "RejoinRoomRequest",
      "type": "object"
    },
    "RoomSettings": {
      "properties": {
        "rounds": {
          "type": "integer"
        },
        "answer_seconds": {
          "type": "number"
        },
        "speed_grace_seconds": {
          "type": "number"
        },
        "round_options": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "answer_options": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "grace_options": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "theme_options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "rounds",
        "answer_seconds",
        "speed_grace_seconds",
        "round_options",
        "answer_options",
        "grace_options",
        "themes",
        "theme_options"
      ],
      "title": "RoomSettings",
      "type": "object"
    },
    "RoomState": {
      "description": "Enviado no evento `room_state` sempre que a sala muda.",
      "properties": {
        "code": {
          "type": "string"
        },
        "status": {
          "enum": [
            "lobby",
            "playing"
          ],
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "max_players": {
          "type": "integer"
        },
        "min_players": {
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/RoomSettings"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerView"
          },
          "type": "array"
        },
        "game": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "status",
        "host_id",
        "max_players",
        "min_players",
        "settings",
        "players",
        "game"
      ],
      "title": "RoomState",
      "type": "object"
    },
    "RoundResult": {
      "properties": {
        "player_id": {
          "type": "string"
        },
        "option": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "correct": {
          "type": "boolean"
        },
        "delta": {
          "type": "integer"
        },
        "bonuses": {
          "items": {
            "$ref": "#/$defs/Bonus"
          },
          "type": "array"
        }
      },
      "required": [
        "player_id",
        "option",
        "correct",
        "delta",
        "bonuses"
      ],
      "title": "RoundResult",
      "type": "object"
    },
    "SubmitAnswerRequest": {
      "properties": {
        "option": {
          "type": "integer"
        }
      },
      "required": [
        "option"
      ],
      "title": "SubmitAnswerRequest",
      "type": "object"
    },
    "UpdateSettingsRequest": {
      "description": "Só os campos enviados mudam.",
      "properties": {
        "rounds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "answer_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "speed_grace_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "themes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "UpdateSettingsRequest",
      "type": "object"
    }
  },
  "title": "Events"
}
